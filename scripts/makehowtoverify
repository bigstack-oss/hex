#!/bin/bash
# HEX SDK

set -e

PROG=$(basename $0)

Usage() {
    echo "Usage: $PROG [options] <shipdir> <release>"
    echo "  Write <shipdir>/<release>_HOW_TO_VERIFY.txt: how someone who downloaded the release"
    echo "  checks its signature and contents, with this release's file names and digests."
    echo
    echo "  -i <identity> -o <issuer>  signed keyless as <identity>, vouched for by <issuer>"
    echo "  -k <pubkey>                signed with a key; <pubkey> is the shipped public key's name"
    echo "  -t                         (with -k) the key is the build's throwaway key"
    echo "  -n                         signed without the transparency log"
    echo "  -c <version>               the cosign version it was signed with"
    echo "  -a <image>                 an image with an SBOM attestation (repeatable)"
    exit 1
}

IDENTITY= ISSUER= PUBKEY= THROWAWAY=0 TLOG=1 COSIGN_VER= ATTESTED=()
while getopts "i:o:k:tnc:a:" opt ; do
    case $opt in
        i) IDENTITY=$OPTARG ;;
        o) ISSUER=$OPTARG ;;
        k) PUBKEY=$OPTARG ;;
        t) THROWAWAY=1 ;;
        n) TLOG=0 ;;
        c) COSIGN_VER=$OPTARG ;;
        a) ATTESTED+=("$OPTARG") ;;
        *) Usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 2 ] || Usage
[ -n "$PUBKEY" ] || [ -n "$IDENTITY" -a -n "$ISSUER" ] || Usage
[ -z "$PUBKEY" ] || [ -z "$IDENTITY$ISSUER" ] || Usage

SHIP=$1 R=$2
SUMS=${R}_SHA256SUMS
BUNDLE=$SUMS.sigstore.json
OUT=$SHIP/${R}_HOW_TO_VERIFY.txt

# Only a manifest that is signed gets instructions: a file like this next to an unsigned
# release would read as a check that is not there.
[ -f "$SHIP/$SUMS" ] || { echo "$PROG: no $SUMS in $SHIP" >&2 ; exit 1 ; }
[ -f "$SHIP/$BUNDLE" ] || { echo "$PROG: $SUMS is not signed (no $BUNDLE)" >&2 ; exit 1 ; }

if [ -n "$PUBKEY" ] ; then
    [ -f "$SHIP/$PUBKEY" ] || { echo "$PROG: no $PUBKEY in $SHIP" >&2 ; exit 1 ; }
    WHO="--key $PUBKEY"
else
    WHO="--certificate-identity $IDENTITY --certificate-oidc-issuer $ISSUER"
fi
[ $TLOG -eq 1 ] || WHO="$WHO --insecure-ignore-tlog"

# The Rekor entry, from the bundle (sigstore bundle v0.3: verificationMaterial.tlogEntries)
LOGINDEX= SIGNED=
if [ $TLOG -eq 1 ] ; then
    LOGINDEX=$(grep -oE '"logIndex": *"?[0-9]+' "$SHIP/$BUNDLE" | head -1 | grep -oE '[0-9]+$' || true)
    T=$(grep -oE '"integratedTime": *"?[0-9]+' "$SHIP/$BUNDLE" | head -1 | grep -oE '[0-9]+$' || true)
    [ -z "$T" ] || SIGNED=$(date -u -d @$T '+%Y-%m-%d %H:%M:%S UTC')
fi

# B (signature, attestations) needs Sigstore's trust data, fetched online, except for a key
# signature made without the transparency log
B_NET=online
[ -z "$PUBKEY" -o $TLOG -eq 1 ] || B_NET="offline with this key"

TMP=$OUT.tmp
trap 'rm -f "$TMP"' EXIT
{
    echo "How to verify $R"
    echo "$(printf '%*s' $((14 + ${#R})) '' | tr ' ' '=')"
    echo
    echo "Two checks. Each has its own commands below:"
    echo
    echo "  A. Integrity (offline): the files you have are exactly the files in this release's"
    echo "     signed list of digests. It catches a corrupted, incomplete or altered download."
    echo "  B. Signature and SBOM attestations ($B_NET): the list itself, and the SBOM of each"
    echo "     image, were signed by the signer below."
    echo
    echo "A alone does not show that the list is genuine; B does. B needs only the small files"
    echo "(the list and the .sigstore.json files), not the images. At a site without Internet"
    echo "access, run A there and B on any machine that has it."
    echo
    echo "  List of digests:  $SUMS"
    echo "  Its signature:    $BUNDLE"
    if [ -n "$PUBKEY" ] ; then
        echo "  Signed with key:  $PUBKEY"
        if [ $THROWAWAY -eq 1 ] ; then
            echo
            echo "  WARNING: this key was generated for this build and ships beside what it"
            echo "  signs. The signature shows the files belong together, not who built them."
        else
            echo "  Compare $PUBKEY with the public key published by the vendor before"
            echo "  trusting it: a key that came with the download proves nothing on its own."
        fi
    else
        echo "  Signer identity:  $IDENTITY"
        echo "  OIDC issuer:      $ISSUER"
    fi
    [ -z "$SIGNED" ] || echo "  Signed at:        $SIGNED"
    [ -z "$LOGINDEX" ] || echo "  Rekor log entry:  $LOGINDEX, https://search.sigstore.dev/?logIndex=$LOGINDEX"
    [ $TLOG -eq 1 ] || echo "  Not recorded in a transparency log."
    [ -z "$COSIGN_VER" ] || echo "  Signed with:      cosign v$COSIGN_VER"
    if [ -z "$PUBKEY" ] ; then
        echo
        echo "Confirm the signer identity and issuer with the vendor through a channel other than"
        echo "this download before relying on them: this file came with the images, so on its own"
        echo "it is no stronger than they are."
    fi
    echo
    echo
    echo "A. Integrity (offline)"
    echo "----------------------"
    echo
    echo "You need sha256sum and no network access. In the directory holding the files you"
    echo "downloaded, run the command below. Every one of them must say \"OK\"; files you did not"
    echo "download are skipped:"
    echo
    echo "    sha256sum -c --ignore-missing $SUMS"
    echo
    echo
    echo "B. Signature and SBOM attestations ($B_NET)"
    echo "$(printf '%*s' $((37 + ${#B_NET})) '' | tr ' ' '-')"
    echo
    echo "You need cosign (https://docs.sigstore.dev/cosign/system_config/installation/)."
    if [ "$B_NET" = online ] ; then
        echo "cosign fetches Sigstore's trust data on its first run, so this needs network access."
    fi
    echo "Run the commands in a directory holding $SUMS and the"
    echo ".sigstore.json files; the images themselves are not needed."
    echo
    echo "B1. The signature of the list of digests. It must print \"Verified OK\":"
    echo
    echo "    cosign verify-blob $WHO --bundle $BUNDLE $SUMS"
    if [ ${#ATTESTED[@]} -gt 0 ] ; then
        echo
        echo "B2. Optional: the SBOM attested to each image -- which SBOM the signer published for"
        echo "    that exact image. Each line must print \"Verified OK\". The digest comes from the"
        echo "    signed list, so the image itself need not be present."
        for N in "${ATTESTED[@]}" ; do
            H=$(awk -v n="$N" '$2 == n { print $1 }' "$SHIP/$SUMS")
            [ -n "$H" ] || { echo "$PROG: $N is not in $SUMS" >&2 ; exit 1 ; }
            [ -f "$SHIP/$N.sbom.sigstore.json" ] || { echo "$PROG: no attestation for $N" >&2 ; exit 1 ; }
            echo
            echo "    $N:"
            echo "    cosign verify-blob-attestation $WHO --type cyclonedx --bundle $N.sbom.sigstore.json --digest $H --digestAlg sha256"
        done
    fi
} > "$TMP"
chmod 0644 "$TMP"
mv -f "$TMP" "$OUT"
